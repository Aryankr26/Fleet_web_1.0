from __future__ import annotations

import logging
from typing import Any, Dict, Optional

import asyncpg

logger = logging.getLogger(__name__)

_pool: Optional[asyncpg.Pool] = None


async def init_db(database_url: str) -> asyncpg.Pool:
    return await asyncpg.create_pool(dsn=database_url, min_size=1, max_size=5)


async def connect_db(database_url: str) -> None:
    global _pool
    if not database_url:
        logger.warning("db_disabled_no_DATABASE_URL")
        _pool = None
        return
    _pool = await init_db(database_url)


async def close_db() -> None:
    global _pool
    if _pool is not None:
        await _pool.close()
        _pool = None


async def insert_telemetry(rec: Dict[str, Any]) -> None:
    # Non-blocking best-effort insert. No-ops if DATABASE_URL not set.
    global _pool
    if _pool is None:
        return

    try:
        async with _pool.acquire() as conn:
            await conn.execute(
                """
                INSERT INTO telemetry_raw (ts, imei, lat, lon, speed, ignition, fuel, raw)
                VALUES (to_timestamp($1/1000.0), $2, $3, $4, $5, $6, $7, $8::jsonb)
                """,
                int(rec.get("timestamp") or 0),
                rec.get("imei"),
                rec.get("lat"),
                rec.get("lon"),
                rec.get("speed"),
                rec.get("ignition"),
                rec.get("fuel"),
                rec.get("raw_json"),
            )
    except Exception:
        logger.exception("db_insert_failed")
